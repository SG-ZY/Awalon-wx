get-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{item.id === 1}}" class="avatar assassinate-target-avatar knight-tone-rose">{{item.id}}</view><view wx:else class="avatar assassinate-target-avatar knight-tone-{{item.avatarTone}}">{{item.id}}</view><text>{{item.name}}</text></button><view wx:else class="mission-choice assassinate-target-button"><image wx:if="{{item.avatarUrl}}" class="assassinate-target-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{item.id === 1}}" class="avatar assassinate-target-avatar knight-tone-rose">{{item.id}}</view><view wx:else class="avatar assassinate-target-avatar knight-tone-{{item.avatarTone}}">{{item.id}}</view><text>{{item.name}}</text></view></block></view></view></view>
