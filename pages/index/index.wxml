
<view class="page-shell {{subPhase === 'assassinationCountdown' || subPhase === 'assassinate' ? 'assassination-active' : ''}} {{identityUnlocked ? 'identity-unlocked' : ''}} {{configOptionsOpen ? 'config-options-open' : ''}} {{fourthQuestFailNeed === 2 ? 'two-fail-needed' : ''}} {{roleCardsExpanded ? 'role-cards-expanded' : ''}}">
  <view class="orb orb-one"></view><view class="orb orb-two"></view>
  
  <button wx:if="{{phase === 'game'}}" class="game-back-button" bindtap="requestEndGame">←</button>
  
  <view class="hero"><view class="eyebrow">THE ROUND TABLE</view><view class="title-row"><text class="crown">♔</text><text class="title">阿瓦隆</text><text class="crown">♔</text></view><text class="subtitle">圆桌之下，忠诚与谎言同时苏醒</text></view>

  <view wx:if="{{phase === 'lobby'}}" class="content-card lobby-card">
    <view wx:if="{{!roomCreated}}">
      
      <view class="setting-row"><view><view class="setting-title-line"><text class="setting-title">本局人数</text><text class="setting-value">{{playerCount}} 人</text></view><text class="setting-copy">长按可快速加减人数</text></view><view class="player-count-actions"><view class="player-count-input"><view class="compact-stepper-button {{playerCount === minPlayerCount ? 'disabled' : ''}}" data-step="-1" bindtap="changePlayerCount" bindlongpress="startPlayerCountRepeat" bindtouchend="stopPlayerCountRepeat" bindtouchcancel="stopPlayerCountRepeat">−</view><text class="player-count-field">{{playerCount}}</text><view class="compact-stepper-button {{playerCount === maxPlayerCount ? 'disabled' : ''}}" data-step="1" bindtap="changePlayerCount" bindlongpress="startPlayerCountRepeat" bindtouchend="stopPlayerCountRepeat" bindtouchcancel="stopPlayerCountRepeat">＋</view></view><button class="config-settings-button" bindtap="toggleConfigOptions">{{configOptionsOpen ? '×' : '⚙'}}</button></view></view>
      
      <view class="role-preview-section"><view class="role-preview-head"><text>本局角色卡牌</text></view><view wx:for="{{goodRoleRows}}" wx:key="index" wx:for-item="group" class="role-preview-grid role-preview-row"><view wx:for="{{group.cards}}" wx:key="id" wx:for-item="role" class="role-preview-card {{role.camp}} {{role.countLabel ? 'has-count' : ''}}" data-id="{{role.id}}" bindtap="openRolePreview" hover-class="role-preview-card-pressed"><text class="role-preview-symbol">{{role.symbol}}</text><view><text class="role-preview-name">{{role.name}}<text wx:if="{{role.countLabel}}" class="role-preview-count">{{role.countLabel}}</text></text><text class="role-preview-camp">好人阵营</text></view></view></view><view wx:for="{{evilRoleRows}}" wx:key="index" wx:for-item="group" class="role-preview-grid role-preview-row evil-role-row"><view wx:for="{{group.cards}}" wx:key="id" wx:for-item="role" class="role-preview-card {{role.camp}} {{role.countLabel ? 'has-count' : ''}}" data-id="{{role.id}}" bindtap="openRolePreview" hover-class="role-preview-card-pressed"><text class="role-preview-symbol">{{role.symbol}}</text><view><text class="role-preview-name">{{role.name}}<text wx:if="{{role.countLabel}}" class="role-preview-count">{{role.countLabel}}</text></text><text class="role-preview-camp">邪恶阵营</text></view></view></view></view>
      <view class="setting-row rule-row"><view><view class="setting-title-line"><text class="setting-title">刺杀讨论时间</text><text class="setting-value">{{assassinationMinutes}} 分钟</text></view><text class="setting-copy">默认 {{defaultAssassinationMinutes}} 分钟，可由房主调整</text></view><view class="player-count-input"><view class="compact-stepper-button {{assassinationMinutes === 1 ? 'disabled' : ''}}" data-step="-1" bindtap="changeAssassinationMinutes" bindlongpress="startAssassinationMinutesRepeat" bindtouchend="stopAssassinationMinutesRepeat" bindtouchcancel="stopAssassinationMinutesRepeat">−</view><input class="player-count-field" type="number" confirm-type="done" maxlength="2" value="{{assassinationMinutes}}" bindblur="validateAssassinationMinutes" bindconfirm="validateAssassinationMinutes"/><view class="compact-stepper-button {{assassinationMinutes === 10 ? 'disabled' : ''}}" data-step="1" bindtap="changeAssassinationMinutes" bindlongpress="startAssassinationMinutesRepeat" bindtouchend="stopAssassinationMinutesRepeat" bindtouchcancel="stopAssassinationMinutesRepeat">＋</view></view></view>
      <!-- //wick 20260808@ Lock the fourth mission condition for both 9-player variants { -->
      <view wx:if="{{playerCount === 5 || playerCount === 6 || playerCount === 9}}" class="setting-row rule-row"><view><text class="setting-title">第四车失败条件</text><text class="setting-copy">{{playerCount === 9 ? (ninePlayerEvilCount === 3 ? '9人3坏时固定需1张失败票' : '9人4坏时固定需2张失败票') : '默认需1张失败票，可由房主调整'}}</text></view><view class="fail-need-toggle"><view wx:if="{{playerCount === 9}}" class="fail-need-option selected">{{ninePlayerEvilCount === 3 ? '需 1 张（固定）' : '需 2 张（固定）'}}</view><block wx:else><view class="fail-need-option {{fourthQuestFailNeed === 1 ? 'selected' : ''}}" data-value="1" bindtap="setFourthQuestFailNeed">需 1 张</view><view class="fail-need-option {{fourthQuestFailNeed === 2 ? 'selected' : ''}}" data-value="2" bindtap="setFourthQuestFailNeed">需 2 张</view></block></view></view>
      <!-- //wick 20260808@ Lock the fourth mission condition for both 9-player variants } -->
      <view wx:if="{{playerCount === 9}}" class="setting-row rule-row"><view><text class="setting-title">9 人坏人数量</text><text class="setting-copy">可手动选择；随机模式会在每次再来一把时重新抽取</text></view><view class="fail-need-toggle"><view class="fail-need-option {{ninePlayerEvilMode === 'manual' && ninePlayerEvilCount === 3 ? 'selected' : ''}}" data-value="3" bindtap="setNinePlayerEvilCount">3 坏</view><view class="fail-need-option {{ninePlayerEvilMode === 'random' ? 'selected' : ''}}" bindtap="randomizeNinePlayerEvilCount">随机</view><view class="fail-need-option {{ninePlayerEvilMode === 'manual' && ninePlayerEvilCount === 4 ? 'selected' : ''}}" data-value="4" bindtap="setNinePlayerEvilCount">4 坏</view></view></view>
      
      <view class="setting-row rule-row"><view><text class="setting-title">该车是否在手机投票</text><text class="setting-copy">开启后，本车骑士依次传递手机完成投票</text></view><view class="fail-need-toggle"><view class="fail-need-option {{!missionPhoneVoting ? 'selected' : ''}}" bindtap="toggleMissionPhoneVoting">关闭</view><view class="fail-need-option {{missionPhoneVoting ? 'selected' : ''}}" bindtap="toggleMissionPhoneVoting">开启</view></view></view>
      
      
      <view class="setting-row rule-row history-guard-row"><view><text class="setting-title">避免连局同角色</text><text class="setting-copy">与上一局角色重复时，身份牌自动重洗</text></view><view class="fail-need-toggle"><view class="fail-need-option {{!consecutiveRoleReroll ? 'selected' : ''}}" bindtap="toggleConsecutiveRoleReroll">关闭</view><view class="fail-need-option {{consecutiveRoleReroll ? 'selected' : ''}}" bindtap="toggleConsecutiveRoleReroll">开启</view></view></view>
      
      
      <view class="setting-row rule-row history-guard-row"><view><text class="setting-title">避免三连有身份</text><text class="setting-copy">忠臣不算身份；连续两局有身份时，下一局优先重洗为忠臣</text></view><view class="fail-need-toggle"><view class="fail-need-option {{!consecutiveSpecialRoleReroll ? 'selected' : ''}}" bindtap="toggleConsecutiveSpecialRoleReroll">关闭</view><view class="fail-need-option {{consecutiveSpecialRoleReroll ? 'selected' : ''}}" bindtap="toggleConsecutiveSpecialRoleReroll">开启</view></view></view>
      
      
      <view class="room-seating-view config-seating-view"><view class="seat-title"><text>圆桌席位</text></view><text class="seat-invite-copy">点击座位头像，设置骑士昵称</text><view class="seats"><view wx:for="{{players}}" wx:key="id" class="seat occupied"><button wx:if="{{item.id === 1}}" class="avatar avatar-button" data-id="{{item.id}}" bindtap="openSeatPassword"><image wx:if="{{item.avatarUrl}}" class="avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"/><text wx:else class="admin-seat-mark">{{item.id}}</text></button><button wx:else class="avatar avatar-button knight-tone-{{item.avatarTone}}" data-id="{{item.id}}" bindtap="openSeatPassword"><image wx:if="{{item.avatarUrl}}" class="avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"/><text wx:else>{{item.id}}</text></button><text class="seat-name">{{item.name}}</text><text wx:if="{{item.id === 1}}" class="seat-status">房主</text></view></view></view>
      
      <button class="primary-button create-room-button" bindtap="createRoom">开始游戏</button>
    </view>
  </view>

  <view wx:elif="{{phase === 'countdown'}}" class="countdown-panel"><text class="countdown-label">所有骑士已就位</text><text class="countdown-number">{{countdown}}</text><text class="countdown-copy">身份牌正在洗切，请将设备交给对应玩家</text></view>

  <view wx:else class="game-layout">
    <view wx:if="{{identityCollapsed}}" class="role-preview-section game-role-preview identity-entry-card" bindtap="openIdentityCard"><view class="role-preview-head role-preview-toggle identity-entry-head"><text>查看身份</text><text class="role-preview-toggle-mark">展开</text></view></view><view wx:else class="identity-card"><view class="identity-head identity-head-toggle role-preview-head" bindtap="toggleIdentitySelection"><text>{{identityUnlocked ? '你的身份信息' : '查看身份'}}</text><text class="role-preview-toggle-mark">收起</text></view><text wx:if="{{!identityUnlocked}}" class="identity-head-copy">点击自己的座位，确认身份后可以查看本局角色</text><view class="identity-seat-grid"><button wx:for="{{players}}" wx:key="id" class="identity-seat {{item.identityViewed ? 'viewed' : ''}}" data-id="{{item.id}}" catchtap="openIdentityPassword"><image wx:if="{{item.avatarUrl}}" class="identity-seat-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{item.id === 1}}" class="avatar identity-seat-avatar"><text class="admin-seat-mark">{{item.id}}</text></view><view wx:else class="avatar identity-seat-avatar knight-tone-{{item.avatarTone}}">●</view><text>{{item.name}}</text></button></view><view wx:if="{{!identityUnlocked}}" class="secret-state"><text class="secret-mark">✦</text><text>点击自己的座位，输入密码查看身份</text></view><view wx:elif="{{roleVisible}}" class="role-state {{selectedPlayer.camp}}"><view class="role-symbol">{{selectedPlayer.symbol}}</view><text class="role-camp">{{selectedPlayer.camp === 'good' ? '好人阵营' : '邪恶阵营'}}</text><text class="role-name">{{selectedPlayer.roleName}}</text><view class="ability"><text class="ability-name">{{selectedPlayer.ability}}</text><text>{{selectedPlayer.effect}}</text></view><view class="vision"><text class="vision-label">本局情报</text><text>{{selectedPlayer.vision}}</text><view wx:if="{{visionPlayers.length}}" class="vision-player-list"><view wx:for="{{visionPlayers}}" wx:key="id" class="vision-player"><image wx:if="{{item.avatarUrl}}" class="vision-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar vision-avatar vision-avatar-fallback knight-tone-{{item.avatarTone}}">{{item.id}}</view><text>{{item.name}}</text></view></view></view><view wx:if="{{selectedSkillStatus}}" class="skill-state"><text class="skill-state-title">{{selectedSkillStatus.title}}</text><text>{{selectedSkillStatus.detail}}</text></view><text wx:if="{{identityCountdown > 0}}" class="identity-countdown">{{identityCountdown}} 秒后自动收起</text><button class="hide-button" bindtap="hideRole">收起身份</button></view></view><view class="role-preview-section game-role-preview"><view class="role-preview-head role-preview-toggle" bindtap="toggleRoleCards"><text>本局角色卡牌</text><text class="role-preview-toggle-mark">{{roleCardsExpanded ? '收起' : '展开'}}</text></view><view wx:for="{{goodRoleRows}}" wx:key="index" wx:for-item="group" class="role-preview-grid role-preview-row"><view wx:for="{{group.cards}}" wx:key="id" wx:for-item="role" class="role-preview-card {{role.camp}} {{role.countLabel ? 'has-count' : ''}}" data-id="{{role.id}}" bindtap="openRolePreview"><text class="role-preview-symbol">{{role.symbol}}</text><view><text class="role-preview-name">{{role.name}}<text wx:if="{{role.countLabel}}" class="role-preview-count">{{role.countLabel}}</text></text><text class="role-preview-camp">好人阵营</text></view></view></view><view wx:for="{{evilRoleRows}}" wx:key="index" wx:for-item="group" class="role-preview-grid role-preview-row evil-role-row"><view wx:for="{{group.cards}}" wx:key="id" wx:for-item="role" class="role-preview-card {{role.camp}} {{role.countLabel ? 'has-count' : ''}}" data-id="{{role.id}}" bindtap="openRolePreview"><text class="role-preview-symbol">{{role.symbol}}</text><view><text class="role-preview-name">{{role.name}}<text wx:if="{{role.countLabel}}" class="role-preview-count">{{role.countLabel}}</text></text><text class="role-preview-camp">邪恶阵营</text></view></view></view></view>

    
    <view class="quest-card"><view class="quest-head"><view class="quest-heading"><text class="quest-title">任务远征</text><text class="quest-round-info">（首车长：{{firstLeaderName}} · {{speakingDirection}}）</text></view><view class="quest-head-side"><view class="quest-view-switch"><view class="quest-view-option {{questView === 'map' ? 'active' : ''}}" data-view="map" bindtap="setQuestView">地图</view><view class="quest-view-option {{questView === 'list' ? 'active' : ''}}" data-view="list" bindtap="setQuestView">列表</view></view><text class="quest-round">第 {{roundNumber}} / 5 轮</text></view></view><view wx:if="{{questView === 'map'}}" class="quest-map quest-map-refined"><view class="map-route"></view><view class="map-stops"><view wx:for="{{questViewItems}}" wx:key="index" class="map-stop {{item.status}} {{item.index === currentQuest + 1 ? 'current' : ''}}" data-index="{{item.index}}" bindtap="openBombCountPicker" bindlongpress="openPhoneTeamPicker"><view class="quest-wagon"><view class="wagon-status"><text class="wagon-index-number">{{item.index}}</text></view><text class="wagon-title">远征 {{item.index}}</text><text class="wagon-copy">{{item.teamSize}} 位骑士</text><text wx:if="{{item.failNeed > 1}}" class="wagon-copy">需 {{item.failNeed}} 票摧毁</text><view wx:if="{{item.riders.length}}" class="wagon-riders"><view wx:for="{{item.riders}}" wx:key="id" wx:for-item="rider" class="wagon-rider"><image wx:if="{{rider.avatarUrl}}" class="wagon-rider-avatar" src="{{rider.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{rider.id === 1}}" class="wagon-rider-avatar knight-tone-rose">{{rider.id}}</view><view wx:else class="wagon-rider-avatar knight-tone-{{rider.avatarTone}}">{{rider.id}}</view><view wx:if="{{rider.isLeader}}" class="wagon-crown wagon-rider-leader"><view class="wagon-crown-spike wagon-crown-spike-left"></view><view class="wagon-crown-spike wagon-crown-spike-middle"></view><view class="wagon-crown-spike wagon-crown-spike-right"></view><view class="wagon-crown-band"></view></view></view></view><text class="wagon-result">{{item.result || (item.index === currentQuest + 1 ? '当前关卡' : '待远征')}}</text></view></view></view></view><view wx:else class="quest-list-view"><view wx:for="{{questViewItems}}" wx:key="index" class="quest-list-item {{item.status}} {{item.index === currentQuest + 1 ? 'current' : ''}}" data-index="{{item.index}}" bindtap="openBombCountPicker" bindlongpress="openPhoneTeamPicker"><view class="quest-list-index"><view class="wagon-index-number">{{item.index}}</view></view><view class="quest-list-info"><text class="quest-list-title">{{item.teamSize}} 人远征</text><text wx:if="{{item.failNeed > 1}}" class="quest-list-copy">需 {{item.failNeed}} 张失败票摧毁此轮任务</text><view wx:if="{{item.riders.length}}" class="quest-list-riders"><view wx:for="{{item.riders}}" wx:key="id" wx:for-item="rider" class="quest-list-rider"><image wx:if="{{rider.avatarUrl}}" class="quest-list-rider-avatar" src="{{rider.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{rider.id === 1}}" class="quest-list-rider-avatar knight-tone-rose">{{rider.id}}</view><view wx:else class="quest-list-rider-avatar knight-tone-{{rider.avatarTone}}">{{rider.id}}</view><view wx:if="{{rider.isLeader}}" class="wagon-crown quest-list-rider-leader"><view class="wagon-crown-spike wagon-crown-spike-left"></view><view class="wagon-crown-spike wagon-crown-spike-middle"></view><view class="wagon-crown-spike wagon-crown-spike-right"></view><view class="wagon-crown-band"></view></view><text class="quest-list-rider-name">{{rider.name}}</text></view></view></view><text class="quest-list-result">{{item.result || (item.index === currentQuest + 1 ? '当前关卡' : '待远征')}}</text></view></view><view class="quest-gesture-hint quest-gesture-hint-inline"><text>长按已有结果的任务车可以编辑车上成员</text><text>单击失败任务车可以修改车上炸弹数量</text></view>
    
    
    
    
      <view wx:if="{{!winner}}"><view wx:if="{{teamMode === 'offline' || selectedPlayerId === 1 || subPhase === 'assassinate' || subPhase === 'assassinationCountdown'}}" class="flow-panel">
        <view wx:if="{{subPhase === 'assassinationCountdown'}}" class="assassination-countdown"><text class="turn-number">好人已完成三次任务</text><text class="assassination-title">刺杀讨论时间</text><text class="assassination-time">{{assassinationTimeText}}</text><text class="assassination-copy">邪恶阵营请讨论刺杀对象，倒计时结束后揭示梅林身份。</text><view wx:if="{{selectedPlayerId === 1 || selectedPlayer.role === 'assassin'}}" class="assassination-target-preview"><text class="assassination-target-preview-title">可选刺杀目标</text><view class="assassination-target-preview-list"><block wx:for="{{goodTargets}}" wx:key="id"><button wx:if="{{selectedPlayerId === 1 || selectedPlayer.role === 'assassin'}}" class="assassination-target-preview-item assassination-target-choice" data-id="{{item.id}}" bindtap="selectAssassinationTarget"><image wx:if="{{item.avatarUrl}}" class="assassinate-target-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{item.id === 1}}" class="avatar assassinate-target-avatar knight-tone-rose">{{item.id}}</view><view wx:else class="avatar assassinate-target-avatar knight-tone-{{item.avatarTone}}">{{item.id}}</view><text>{{item.name}}</text></button><view wx:else class="assassination-target-preview-item"><image wx:if="{{item.avatarUrl}}" class="assassinate-target-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{item.id === 1}}" class="avatar assassinate-target-avatar knight-tone-rose">{{item.id}}</view><view wx:else class="avatar assassinate-target-avatar knight-tone-{{item.avatarTone}}">{{item.id}}</view><text>{{item.name}}</text></view></block></view></view></view>
        <view wx:elif="{{subPhase === 'assassinate'}}" class="private-action"><text class="turn-number">好人已完成三次任务</text><text class="turn-player">梅林身份揭示</text><text>请将设备交给刺客，从好人名单中选择刺杀目标</text><view class="assassinate-targets"><button wx:for="{{goodTargets}}" wx:key="id" class="mission-choice assassinate-target-button" data-id="{{item.id}}" bindtap="selectAssassinationTarget"><image wx:if="{{item.avatarUrl}}" class="assassinate-target-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{item.id === 1}}" class="avatar assassinate-target-avatar knight-tone-rose">{{item.id}}</view><view wx:else class="avatar assassinate-target-avatar knight-tone-{{item.avatarTone}}">{{item.id}}</view><text>{{item.name}}</text></button></view></view>
        <view wx:elif="{{teamMode === 'offline'}}"><view wx:if="{{missionPhoneVoting}}"><view wx:if="{{subPhase === 'phoneTeam'}}" class="phone-team-panel"><view class="phone-team-hero"><view class="phone-team-rule"><view class="phone-team-rule-line"></view><text>✦</text><view class="phone-team-rule-line"></view></view><view class="phone-team-round"><text>第</text><text class="phone-team-round-number">{{roundNumber}}</text><text>趟车任务</text></view><text class="phone-team-fail">💣 炸毁需 {{currentQuestFailNeed}} 枚炸弹</text></view><button class="primary-button quest-button phone-team-start" bindtap="startPhoneMission"><text class="phone-team-start-text">手机投票</text></button><view class="phone-host-manual"><view class="phone-host-manual-divider"></view><text class="phone-host-manual-title">亦可手动记录</text><view class="host-choice-list"><button class="host-choice offline-success" data-result="success" bindtap="markOfflineMission">任务成功</button><button class="host-choice offline-fail" data-result="fail" bindtap="markOfflineMission">任务失败</button></view></view></view><view wx:elif="{{subPhase === 'phoneMission'}}" class="private-action"><text class="turn-number">任务投票（{{missionCurrentNumber}} / {{currentQuestTeamSize}}）</text><view wx:if="{{!phoneVoterId}}"><button class="reselect-mission-voter" bindtap="cancelPhoneMissionVoting">取消投票</button><view class="turn-player phone-mission-round-title"><text>第</text><text class="phone-mission-round-number">{{roundNumber}}</text><text>趟车任务</text></view><text class="setting-copy">炸毁需 {{currentQuestFailNeed}} 枚炸弹</text><view class="phone-mission-seat-grid"><button wx:for="{{phoneMissionPlayers}}" wx:key="id" class="phone-mission-seat {{item.missionVoted ? 'voted' : ''}}" data-id="{{item.id}}" bindtap="selectPhoneMissionVoter" bindlongpress="requestPhoneVoteReset"><image wx:if="{{item.avatarUrl}}" class="phone-mission-seat-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{item.id === 1}}" class="avatar phone-mission-seat-avatar knight-tone-rose">{{item.id}}</view><view wx:else class="avatar phone-mission-seat-avatar knight-tone-{{item.avatarTone}}">{{item.id}}</view><text>{{item.name}}</text><text wx:if="{{item.missionVoted}}" class="phone-mission-voted-label">已投票</text></button></view><text class="phone-vote-reset-hint">长按已投席位可撤回该次投票</text></view><view wx:else><button class="reselect-mission-voter" bindtap="resetPhoneMissionVoter">取消投票</button><text class="turn-player">{{phoneVoterName}}</text><text wx:if="{{phoneMissionCanFail}}">请选择一张任务牌</text><text wx:else>请选择一张任务牌</text><view wx:if="{{phoneMissionCanFail}}" class="mission-choice-list"><button class="mission-choice" data-card="success" bindtap="submitMissionCard">任务成功</button><button class="mission-choice" data-card="fail" bindtap="submitMissionCard">任务失败</button></view><view wx:else class="mission-choice-list"><button class="mission-choice" data-card="success" bindtap="submitMissionCard">任务成功</button><button class="mission-choice" data-card="success" bindtap="submitMissionCard">任务失败</button></view></view></view><view wx:else class="private-action"><text class="turn-number">任务投票（{{missionCurrentNumber}} / {{currentQuestTeamSize}}）</text><view class="turn-player phone-mission-round-title"><text>第</text><text class="phone-mission-round-number">{{roundNumber}}</text><text>趟车任务</text></view><text class="setting-copy">炸毁需 {{currentQuestFailNeed}} 枚炸弹</text><view class="phone-mission-seat-grid"><button wx:for="{{phoneMissionPlayers}}" wx:key="id" class="phone-mission-seat {{item.missionVoted ? 'voted' : ''}}" data-id="{{item.id}}" bindtap="selectPhoneMissionVoter" bindlongpress="requestPhoneVoteReset"><image wx:if="{{item.avatarUrl}}" class="phone-mission-seat-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:elif="{{item.id === 1}}" class="avatar phone-mission-seat-avatar knight-tone-rose">{{item.id}}</view><view wx:else class="avatar phone-mission-seat-avatar knight-tone-{{item.avatarTone}}">{{item.id}}</view><text>{{item.name}}<