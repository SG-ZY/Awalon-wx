        <view wx:else><view class="flow-status"><text class="flow-label">{{subPhase === 'team' ? '组队阶段' : subPhase === 'decision' ? '房主判定' : '最终刺杀'}}</text><text>{{notice}}</text></view><view wx:if="{{subPhase === 'team'}}"><text class="leader-line">本轮队长：{{leaderName}}　否决次数：{{rejectionCount}} / 5</text><view class="team-grid"><view wx:for="{{teamPlayers}}" wx:key="id" class="team-player {{item.picked ? 'picked' : ''}}" data-id="{{item.id}}" bindtap="toggleTeam">{{item.name}}</view></view><button class="primary-button quest-button" bindtap="submitTeam">提交远征队（{{teamCount}} / {{currentQuestTeamSize}}）</button></view><view wx:elif="{{subPhase === 'decision'}}" class="host-decision"><text>由房主确认本车是否出发</text><view class="host-choice-list"><button class="host-choice" data-result="flow" bindtap="markHostDecision">流车</button><button class="host-choice" data-result="mission" bindtap="markHostDecision">开始任务投票</button></view></view><view wx:elif="{{subPhase === 'mission'}}" class="private-action"><text class="turn-number">任务投票（{{missionCurrentNumber}} / {{missionQueue.length}}）</text><text class="turn-player">{{missionPlayerName}}</text><text wx:if="{{missionCanFail}}">请选择要投放的任务牌</text><text wx:else>请选择一张同意票</text><view wx:if="{{missionCanFail}}" class="mission-choice-list"><button class="mission-choice" data-card="success" bindtap="submitMissionCard">同意 · 任务成功</button><button class="mission-choice" data-card="fail" bindtap="submitMissionCard">反对 · 任务失败</button></view><view wx:else class="mission-choice-list"><button class="mission-choice" data-card="success" bindtap="submitMissionCard">同意 · 任务成功</button><button class="mission-choice" data-card="success" bindtap="submitMissionCard">反对 · 任务失败</button></view></view><view wx:elif="{{subPhase === 'assassinate'}}" class="private-action"><text class="turn-number">好人已完成三次任务</text><text class="turn-player">刺杀目标</text><text>请由刺客从好人名单中选择目标</text><view class="assassinate-targets"><button wx:for="{{goodTargets}}" wx:key="id" class="mission-